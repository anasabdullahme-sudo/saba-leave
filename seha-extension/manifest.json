{
  "manifest_version": 3,
  "name": "سابا ← صحة",
  "short_name": "Saba Seha",
  "version": "1.8.7",
  "description": "أداة داخلية لموظفي استقبال مجمع عيادات سابا: تعبئة نموذج الإجازات في منصة صحة، تنبيهات حالة الأطباء، وبطاقة الطبيب في نظام أثير.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "سابا ← صحة",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.seha.sa/*",
        "https://seha.sa/*",
        "https://*.seha.sa/*"
      ],
      "js": [
        "seha.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*.github.io/*",
        "https://*.netlify.app/*",
        "https://*.web.app/*",
        "https://*.firebaseapp.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "alert.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://saba.athir.net/*",
        "https://*.athir.net/*"
      ],
      "js": [
        "athir.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://saba.athir.net/*",
        "https://*.athir.net/*"
      ],
      "js": [
        "doctor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://anasabdullahme-sudo.github.io/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "optional_permissions": [
    "notifications"
  ]
}